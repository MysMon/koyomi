{
  "name": "@koyomi-cal/react",
  "version": "0.2.0",
  "description": "ヘッドレスな TypeScript/React カレンダーライブラリ（月・週・日・リスト・年・複数月・リソース・タイムライン表示、インタラクティブ操作、マルチタイムゾーン、RRULE 対応）",
  "keywords": [
    "react",
    "calendar",
    "headless",
    "typescript",
    "scheduler",
    "events",
    "recurrence",
    "rrule",
    "timezone",
    "date-fns",
    "カレンダー",
    "予定表"
  ],
  "author": "Yutaro Fujikawa",
  "license": "MIT",
  "homepage": "https://github.com/MysMon/koyomi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MysMon/koyomi.git",
    "directory": "packages/react-calendar"
  },
  "bugs": {
    "url": "https://github.com/MysMon/koyomi/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./theme.css": "./dist/theme/default.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "publint": "0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rrule": "^2.8.1",
    "tsup": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
