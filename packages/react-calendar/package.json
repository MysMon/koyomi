{
  "name": "@koyomi-cal/react",
  "version": "0.2.0",
  "description": "ヘッドレスな TypeScript/React カレンダーライブラリ（月・週・日・リスト表示、Google カレンダー相当のインタラクティブ操作、マルチタイムゾーン、RRULE 完全対応）",
  "keywords": [
    "react",
    "calendar",
    "headless",
    "typescript",
    "scheduler",
    "events",
    "recurrence",
    "rrule",
    "timezone",
    "date-fns",
    "カレンダー",
    "予定表"
  ],
  "author": "Yutaro Fujikawa",
  "license": "MIT",
  "homepage": "https://github.com/koyomi-cal/koyomi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koyomi-cal/koyomi.git",
    "directory": "packages/react-calendar"
  },
  "bugs": {
    "url": "https://github.com/koyomi-cal/koyomi/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "date-fns": "^4.1.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "vitest": "^3.0.0"
  }
}
