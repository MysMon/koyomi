{
  "name": "koyomi-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @koyomi-cal/react build",
    "test": "pnpm --filter @koyomi-cal/react test",
    "test:watch": "pnpm --filter @koyomi-cal/react test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "demo": "pnpm --filter @koyomi-cal/demo dev",
    "terms": "node scripts/check-terms.mjs",
    "check": "pnpm terms && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "tsup>esbuild": ">=0.28.1",
      "bundle-require>esbuild": ">=0.28.1",
      "vite>esbuild": ">=0.28.1"
    }
  }
}
