{
  "name": "koyomi-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @koyomi-cal/react build",
    "test": "pnpm --filter @koyomi-cal/react test",
    "test:e2e": "playwright test",
    "bench": "playwright test --config=playwright.bench.config.ts stress-bench.spec.ts",
    "bench:ci": "playwright test --config=playwright.bench.config.ts regression.spec.ts",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "test:pairs": "node scripts/check-test-pairs.mjs",
    "docs:en-pairs": "node scripts/check-docs-translation-pairs.mjs",
    "test:watch": "pnpm --filter @koyomi-cal/react test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "demo": "pnpm --filter @koyomi-cal/demo dev",
    "terms": "node scripts/check-terms.mjs",
    "check": "pnpm terms && pnpm test:pairs && pnpm docs:en-pairs && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "tsup>esbuild": ">=0.28.1",
      "bundle-require>esbuild": ">=0.28.1",
      "vite>esbuild": ">=0.28.1"
    }
  }
}
